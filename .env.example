# InkOS Environment Configuration
# Copy to .env and fill in your values

# LLM Provider (openai, anthropic, aliyun, custom)
# - openai: OpenAI GPT models
# - anthropic: Anthropic Claude models
# - aliyun: Alibaba Cloud 通义千问 (Qwen)
# - custom: Custom LLM provider (any OpenAI-compatible API)
INKOS_LLM_PROVIDER=openai

# API Base URL
# OpenAI: https://api.openai.com/v1
# Aliyun (通义千问): https://dashscope.aliyuncs.com/compatible-mode/v1
# Custom: Your custom endpoint
INKOS_LLM_BASE_URL=https://api.openai.com/v1

# API Key
INKOS_LLM_API_KEY=sk-your-key-here

# Model name
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# Aliyun: qwen-plus, qwen-max, qwen-turbo
# Custom: Your model name
INKOS_LLM_MODEL=gpt-4o

# Optional: Thinking budget for Anthropic models
# INKOS_LLM_THINKING_BUDGET=0

# Notifications (optional)
INKOS_TELEGRAM_BOT_TOKEN=
INKOS_TELEGRAM_CHAT_ID=
INKOS_FEISHU_WEBHOOK_URL=
INKOS_WECOM_WEBHOOK_URL=
